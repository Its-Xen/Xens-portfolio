{
  // Cloudflare Workers configuration for the OpenNext adapter.
  // Docs: https://opennext.js.org/cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // ── D1 database (contact messages) ─────────────────────────
  // 1. Create it:      bunx wrangler d1 create portfolio-db
  // 2. Copy the printed `database_id` into the line below.
  // 3. Run migration:  bun run cf:d1:migrate
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
  // ── Secrets (set via CLI, never commit these) ──────────────
  //   bunx wrangler secret put TELEGRAM_BOT_TOKEN
  //   bunx wrangler secret put TELEGRAM_CHAT_ID
  //   bunx wrangler secret put WEB3FORMS_ACCESS_KEY
}
